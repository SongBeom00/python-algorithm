   ],
   "source": [
    "x = ['a' ,'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm']\n",
    "\n",
    "# [e, f, g] 출력\n",
    "\n",
    "print(x[4:7])\n",
    "\n",
    "print(x[-9:-6])\n",
    "\n",
    "print(x[4:-6])\n",
    "\n",
    "print(x[-9:7])\n",
    "\n",
    "print(x[6:3:-1])\n",
    "\n",
    "print(list(reversed(x[6:3:-1])))"
   ]
